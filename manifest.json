{
  "manifest_version": 3,
  "name": "Teams: Hide Out of Office Notice",
  "version": "1.1.0",
  "description": "Hides the \"out of office and may not respond\" notice in Microsoft Teams chats, in every Teams language.",
  "browser_specific_settings": {
    "gecko": {
      "id": "teams-hide-ooo@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "notices.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
